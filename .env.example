# === LLM ===
ANTHROPIC_API_KEY=sk-ant-api-key

# === Jira ===
JIRA_BASE_URL=https://helix-it-helpdesk.atlassian.net
JIRA_USER_EMAIL=user@email.com
JIRA_API_TOKEN=token
JIRA_PROJECT_KEY=KAN

# === Agent ===
LLM_TEMPERATURE=0.0
CONFIDENCE_THRESHOLD=0.45        # Below this score → force DEFER
MAX_CHUNKS=4                     # Top-k chunks to retrieve
CHROMA_PERSIST_DIR=./chroma_db
POLICIES_DIR=./policies

# === FastAPI ===
WEBHOOK_SECRET=your-webhook-secret-here
API_HOST=0.0.0.0
API_PORT=8000

# === Eval ===
EVAL_JIRA_LABEL=eval-set         # Label used to filter eval tickets
